    "npm-run-all": "4.1.3",
    "protractor": "~5.4.0",
    "raw-loader": "~1.0.0",
    "recursive-copy": "^2.0.10",
    "replace-in-file": "^3.4.2",
    "rxjs-tslint": "^0.1.8",
    "rxjs-tslint-rules": "^4.24.3",
    "sass-variable-loader": "^0.1.2",
    "script-loader": "^0.7.2",
    "ts-node": "~7.0.0",
    "tsickle": "^0.37.0",
    "tslint": "~5.15.0",
    "tslint-jasmine-rules": "^1.5.1",
    "tslint-language-service": "0.9.9",
    "tslint-no-unused-expression-chai": "^0.1.4",
    "typescript": "~3.5.3",
    "webpack-bundle-analyzer": "^3.5.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit"
    }
  }
