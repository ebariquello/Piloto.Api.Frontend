{
  "name": "webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev-mock",
    "dev-mock": "ng serve -c dev-mock",
    "dev-local": "ng serve -c dev-local --proxy-config proxy.config.ts --ssl true --ssl-key /node_modules/browser-sync/lib/server/certs/server.key --ssl-cert /node_modules/browser-sync/lib/server/certs/server.crt",
    "dev": "ng serve -c dev",
    "hml": "ng serve -c hom",
    "prd": "ng serve -c prd",
    "coverage:watch": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng test --code-coverage --browsers=RedeChromeHeadless",
    "coverage": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng test --watch=false --source-map=false --code-coverage --browsers=RedeChromeHeadless",
    "lint": "ng lint webapp",
    "e2e": "ng e2e",
    "sonar": "sonar-scanner",
    "json": "json-server tests/mock/api/apidata.js -p 3500 -m tests/mock/middleware/custom-middleware.js -r tests/mock/routes/routes.json",
    "precommit": "npm run lint && npm run coverage",
    "prebuild": "ts-node gitversion.ts",
    "build": "npm run build:dev",
    "build:dev": "npm run prebuild && ng build --aot",
    "build:dev-local": "npm run prebuild && ng build -c dev-local --aot",
    "build:dev-mock": "npm run prebuild && ng build -c dev-mock",
    "build:hml": "npm run prebuild && ng build -c hml --prod",
    "build:prd": "npm run prebuild && ng build -c prd --prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~8.2.14",
    "@angular/cdk": "^8.2.3",
    "@angular/common": "~8.2.14",
    "@angular/compiler": "~8.2.14",
    "@angular/core": "~8.2.14",
    "@angular/forms": "~8.2.14",
    "@angular/material": "~8.2.3",
    "@angular/platform-browser": "~8.2.14",
    "@angular/platform-browser-dynamic": "~8.2.14",
    "@angular/router": "~8.2.14",
    "@webcomponents/webcomponentsjs": "^2.2.10",
    "angular-imask": "^6.0.5",
    "angular2-text-mask": "^8.0.4",
    "bootstrap": "^3.3.7",
    "bootstrap.native": "^2.0.21",
    "classlist.js": "^1.1.20150312",
    "core-js": "^3.1.3",
    "element-closest": "^2.0.2",
    "guid-typescript": "^1.0.9",
    "jquery": "^3.3.1",
    "jsonwebtoken": "^8.5.1",
    "jwt-decode": "^4.0.0",
    "lodash.clonedeep": "^4.5.0",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.14",
    "moment-with-locales-es6": "^1.0.1",
    "ng-lottie": "^0.3.2",
    "ng2-charts": "^1.6.0",
    "ng2-file-upload": "^1.3.0",
    "ngx-drag-drop": "^2.0.0",
    "ngx-joyride": "2.2.1",
    "ngx-scrollbar": "^1.5.7",
    "ngx-smart-modal": "^7.4.1",
    "ngx-take-until-destroy": "^5.4.0",
    "ngx-toastr": "^11.3.3",
    "perfect-scrollbar": "^1.3.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~6.5.3",
    "rxjs-compat": "^6.5.2",
    "socket.io": "^2.3.0",
    "socket.io-client": "^2.3.0",
    "text-mask-addons": "^3.7.2",
    "ts-key-enum": "^2.0.2",
