    "karma-jasmine": "^3.1.0",
    "karma-jasmine-html-reporter": "^1.5.1",
    "karma-json-reporter": "^1.2.1",
    "karma-junit-reporter": "^1.2.0",
    "ng-packagr": "^5.7.1",
    "ngx-highlightjs": "^3.0.3",
    "node-static": "^0.7.11",
